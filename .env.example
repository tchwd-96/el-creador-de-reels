# GEMINI_API_KEY: Required for "Mejorar con Gemini" Spanish script generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Vertex AI configuration (alternative to GEMINI_API_KEY on Cloud Run):
# GOOGLE_GENAI_USE_VERTEXAI="false"
# GOOGLE_CLOUD_PROJECT=""
# GOOGLE_CLOUD_LOCATION="us-central1"

# Optional Google Cloud Storage bucket for automatic upload of rendered .mp4 and .zip files:
# GCS_BUCKET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
